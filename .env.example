# ============================================================
# Bu qiymatlar Vercel loyihasida "Settings -> Environment Variables"
# bo'limiga qo'shiladi (bu faylga emas). Lokal test uchun .env yarating.
# ============================================================

# --- Telegram xabarnomalari uchun (MAJBURIY, aks holda buyurtma/ariza xabarlari kelmaydi) ---
BOT_TOKEN=
ADMIN_CHAT_ID=

# --- Umumiy ma'lumotlar bazasi (TAVSIYA ETILADI) ---
# Vercel loyihangizda: Storage -> Create Database -> KV (Upstash Redis) -> loyihaga ulang.
# Ulangach bu kalitlar avtomatik qo'shiladi, qo'lda kiritish shart emas:
#   KV_REST_API_URL=
#   KV_REST_API_TOKEN=
# KV ulanmasa ham sayt ishlayveradi, lekin ma'lumotlar faqat shu brauzerda saqlanadi
# (har bir mijozda alohida, umumiy bo'lmaydi).

# --- Ixtiyoriy: AI yordamchisi (SmartAssistant) uchun Gemini kaliti ---
# Kalit bo'lmasa ham ilova to'liq ishlaydi (faqat AI yordamchi javob bermaydi).
# DIQQAT: bu kalit hozircha build vaqtida frontendga "yopishtiriladi" (ochiq bo'ladi).
# Haqiqiy/pullik kalit qo'ymang; kerak bo'lsa buni alohida so'rang, server-proksi qilib beramiz.
GEMINI_API_KEY=
